auto lo
iface lo inet loopback

iface nic0 inet manual

auto vmbr0
iface vmbr0 inet static
	address 10.0.10.12/24
	gateway 10.0.10.1
	bridge-ports nic0
	bridge-stp off
	bridge-fd 0
	bridge-vlan-aware yes
	bridge-vids 2-4094

source /etc/network/interfaces.d/*

auto vmbr1
iface vmbr1 inet manual
	bridge-ports none
	bridge-stp off
	bridge-fd 0
	post-up echo 1 > /proc/sys/net/ipv4/ip_forward
	post-up iptables -t nat -A POSTROUTING -s '10.0.30.21/24' -o vmbr0 -j MASQUERADE
	post-down iptables -t nat -D POSTROUTING -s '10.0.30.21/24' -o vmbr0 -j MASQUERADE
# Subnet 10.0.30.21/24 using vmbr0 for gateway

 vmbr1 and its NAT rule are remnants of an earlier macOS VM networking experiment. They are not part of the current production network topology.